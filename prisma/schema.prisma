generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgeRange {
  AGE_18_25
  AGE_26_35
  AGE_36_45
  AGE_46_60
  AGE_60_PLUS
}

enum GenderPresentation {
  MALE
  FEMALE
  ANDROGYNOUS
  OTHER
}

enum OrderType {
  SUBSCRIPTION
  PAY_PER_USE
  REQUEST
}

enum OrderStatus {
  PENDING
  PAID
  ACTIVE
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

model Actor {
  id                 String              @id @default(uuid())
  name               String
  ageRange           AgeRange
  genderPresentation GenderPresentation  @default(OTHER)
  styleTags          String[]            @default([])
  vibeTags           String[]            @default([])
  emotionTags        String[]            @default([])
  languages          String[]            @default([])
  bioShort           String
  imageUrls          String[]
  voiceSampleUrl     String?
  videoSampleUrl     String?
  isPublished        Boolean             @default(false)
  viewCount          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orders             Order[]
  views              ActorView[]

  @@index([isPublished, createdAt])
  @@index([viewCount])
}

model LicensePlan {
  id                  String   @id @default(uuid())
  name                String   @unique
  priceMonthly        Int?
  priceOneTime        Int?
  includedActorsCount Int?
  includedVoiceMinutes Int?
  termsUrl            String
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  orders              Order[]
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  actorId         String?
  planId          String?
  type            OrderType
  status          OrderStatus @default(PENDING)
  stripeSessionId String?
  companyName     String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor           Actor?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  plan            LicensePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorId])
  @@index([planId])
  @@index([status])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  views        ActorView[]

  @@index([role])
}

model ActorView {
  id        String   @id @default(uuid())
  actorId   String
  userId    String?
  ipAddress String?
  createdAt DateTime @default(now())
  actor     Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([userId])
}
